NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-role key (Supabase dashboard > Project Settings > API). Required for
# admin actions and the scheduled-post cron worker. Server-only, never expose.
SUPABASE_SECRET_KEY=your-service-role-key-here

# OpenRouter (or OpenAI) key used for post generation.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Threads OAuth app credentials.
NEXT_PUBLIC_THREAD_APP_ID=your-threads-app-id
THREAD_APP_SECRET=your-threads-app-secret

# Shared secret checked against the Authorization header on the
# /api/cron/publish-scheduled route. Vercel Cron sends this automatically
# when CRON_SECRET is set in the project's environment variables.
CRON_SECRET=your-cron-secret-here

# Resend (resend.com) for scheduled-post success/failure emails.
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=notifications@yourdomain.com

NEXT_PUBLIC_ENABLE_TEST_TOOLS=false
